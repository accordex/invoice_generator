DATABASE_URL="postgresql://user:pass@localhost:5432/invoice_dev"
# If password contains @ # % etc., URL-encode them (e.g. Invoice@123 → Invoice%40123)
# Public URL must match the domain users open in the browser (include https).
# Example production: https://invoicegenerator.softmerce.com
# With trustHost: true you may omit AUTH_URL/NEXTAUTH_URL if nginx sends Host correctly.
AUTH_URL="http://localhost:3000"
AUTH_SECRET="<generate via openssl rand -base64 32>"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="<generate via openssl rand -base64 32>"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
APP_BASE_URL="http://localhost:3000"
